.vscode/**
.git/**
.github/**
.claude/**
# Local agent-tool scratch (self-ignored in git, but on disk when packaging locally).
.superpowers/**
.gitignore
.editorconfig
eslint.config.js
.prettierrc.yml
cspell.json
CLAUDE.md
cisco-ios-lsp-plan.md
scripts/**
import_scripts/**
_manuals/**
_testing/**
# Any local underscore folder (_dummy/ screenshot imports, ...) never ships.
_*/**
images/icon.svg
images/README.md
# The store changelog is dist/CHANGELOG.md (scripts/store-changelog.js, via --changelog-path):
# the repo file minus its empty [Unreleased] slot.
CHANGELOG.md
# Store-page/README screenshots are linked from GitHub, not shipped.
media/**
CONTRIBUTING.md
# The store page is STORE.md (packed as the readme via --readme-path); the GitHub README
# would clash with it.
README.md
.publicignore
**/.DS_Store
# Sources are bundled into dist/** by scripts/build.js — only dist ships.
client/**
server/**
test/**
node_modules/**
package-lock.json
*.vsix
build/**
# Alternative icon and its notes stay in the repo only.
icons/cisco-file-outline.svg
icons/README.md
